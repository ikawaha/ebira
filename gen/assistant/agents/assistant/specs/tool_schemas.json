{
  "tools": [
    {
      "id": "notes.get",
      "service": "notes",
      "toolset": "notes.notes",
      "title": "Get",
      "description": "Get the full content of a note by ID",
      "payload": {
        "name": "GetPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Note ID",
              "example": "be4c1193735ee1",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        }
      },
      "result": {
        "name": "GetResult",
        "schema": {
          "$defs": {
            "TextRange": {
              "additionalProperties": false,
              "description": "Range of characters, in Unicode code point offsets",
              "properties": {
                "end": {
                  "description": "Offset just past the last character",
                  "format": "int64",
                  "type": "integer"
                },
                "start": {
                  "description": "Offset of the first character",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "title": "TextRange",
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "Body in Markdown",
              "type": "string"
            },
            "body_highlights": {
              "description": "Ranges of the body matched by the query of get, sorted and not overlapping",
              "items": {
                "$ref": "#/$defs/TextRange"
              },
              "type": "array"
            },
            "created_at": {
              "description": "Creation time",
              "example": "2026-10-16T09:30:00Z",
              "format": "date-time",
              "type": "string"
            },
            "created_by": {
              "description": "Who created the note: ai for a note created by an AI client (create_ai_note); absent for people",
              "enum": [
                "ai"
              ],
              "type": "string"
            },
            "id": {
              "description": "Note ID: the file name without the extension (notes/\u003cnotebook\u003e/\u003cid\u003e.yaml), unique across notebooks",
              "example": "be4c1193735ee1",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "notebook": {
              "description": "Notebook (directory) the note is in",
              "example": "inbox",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "tags": {
              "description": "Tags",
              "example": [
                "DB",
                "postgres"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "description": "Title",
              "example": "Get the CREATE TABLE statement",
              "type": "string"
            },
            "title_highlights": {
              "description": "Ranges of the title matched by the query of get, sorted and not overlapping",
              "items": {
                "$ref": "#/$defs/TextRange"
              },
              "type": "array"
            },
            "trashed_from": {
              "description": "Notebook the note was in before it was moved to the trash",
              "example": "inbox",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "trashed_notebook": {
              "description": "For a note of a notebook deleted as a whole: the ID of that notebook, which is in the trash. notebook is then trash, and restoring the note puts it back into that notebook",
              "example": "inbox",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "updated_at": {
              "description": "Last update time",
              "example": "2026-10-16T09:30:00Z",
              "format": "date-time",
              "type": "string"
            },
            "version": {
              "description": "Strong entity tag of the note file. Sent as the ETag header over HTTP",
              "example": "\"87ef7c76b82c5b1d299b08b474f6a7bb\"",
              "type": "string"
            }
          },
          "required": [
            "id",
            "notebook",
            "title",
            "tags",
            "created_at",
            "updated_at",
            "body",
            "version"
          ],
          "type": "object"
        }
      }
    },
    {
      "id": "notes.search",
      "service": "notes",
      "toolset": "notes.notes",
      "title": "Search",
      "description": "Full-text search over notes. Japanese terms are supported",
      "payload": {
        "name": "SearchPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "Maximum number of notes",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            "notebook": {
              "description": "Only notes in this notebook. Omit for all notebooks except the trash",
              "example": "inbox",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "q": {
              "description": "Search terms separated by spaces, combined with AND",
              "minLength": 1,
              "type": "string"
            },
            "session": {
              "description": "Session of people signed in with a passkey, set as a cookie by the server",
              "type": "string"
            },
            "tag": {
              "description": "Only notes with this tag",
              "type": "string"
            }
          },
          "required": [
            "q"
          ],
          "type": "object"
        }
      },
      "result": {
        "name": "SearchResult",
        "schema": {
          "$defs": {
            "NoteSummary": {
              "additionalProperties": false,
              "properties": {
                "created_at": {
                  "description": "Creation time",
                  "example": "2026-10-16T09:30:00Z",
                  "format": "date-time",
                  "type": "string"
                },
                "created_by": {
                  "description": "Who created the note: ai for a note created by an AI client (create_ai_note); absent for people",
                  "enum": [
                    "ai"
                  ],
                  "type": "string"
                },
                "id": {
                  "description": "Note ID: the file name without the extension (notes/\u003cnotebook\u003e/\u003cid\u003e.yaml), unique across notebooks",
                  "example": "be4c1193735ee1",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                  "type": "string"
                },
                "notebook": {
                  "description": "Notebook (directory) the note is in",
                  "example": "inbox",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                  "type": "string"
                },
                "snippet": {
                  "description": "Excerpt around the matched terms (search only)",
                  "type": "string"
                },
                "snippet_highlights": {
                  "description": "Ranges of the snippet matched by the query, sorted and not overlapping (search only)",
                  "items": {
                    "$ref": "#/$defs/TextRange"
                  },
                  "type": "array"
                },
                "tags": {
                  "description": "Tags",
                  "example": [
                    "DB",
                    "postgres"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "title": {
                  "description": "Title",
                  "example": "Get the CREATE TABLE statement",
                  "type": "string"
                },
                "title_highlights": {
                  "description": "Ranges of the title matched by the query, sorted and not overlapping (search only)",
                  "items": {
                    "$ref": "#/$defs/TextRange"
                  },
                  "type": "array"
                },
                "trashed_notebook": {
                  "description": "For a note of a notebook deleted as a whole: the ID of that notebook, which is in the trash. notebook is then trash, and restoring the note puts it back into that notebook",
                  "example": "inbox",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                  "type": "string"
                },
                "updated_at": {
                  "description": "Last update time",
                  "example": "2026-10-16T09:30:00Z",
                  "format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "notebook",
                "title",
                "tags",
                "created_at",
                "updated_at"
              ],
              "title": "NoteSummary",
              "type": "object"
            },
            "TextRange": {
              "additionalProperties": false,
              "description": "Range of characters, in Unicode code point offsets",
              "properties": {
                "end": {
                  "description": "Offset just past the last character",
                  "format": "int64",
                  "type": "integer"
                },
                "start": {
                  "description": "Offset of the first character",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "title": "TextRange",
              "type": "object"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "description": "Search mode used",
              "enum": [
                "like",
                "bigram",
                "trigram",
                "en",
                "ja"
              ],
              "type": "string"
            },
            "notes": {
              "description": "Matched notes",
              "items": {
                "$ref": "#/$defs/NoteSummary"
              },
              "type": "array"
            },
            "total": {
              "description": "Number of matched notes",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "total",
            "notes"
          ],
          "type": "object"
        }
      }
    }
  ]
}
